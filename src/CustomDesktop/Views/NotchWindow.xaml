<base:NonActivatingWindow x:Class="CustomDesktop.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:base="clr-namespace:CustomDesktop.Views.Base"
        xmlns:vm="clr-namespace:CustomDesktop.ViewModels"
        mc:Ignorable="d"
        Title="Custom Desktop Notch"
        Width="{Binding WidthCompact, FallbackValue=220}"
        Height="{Binding HeightCompact, FallbackValue=36}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">

    <Grid x:Name="RootGrid" Margin="0">
        <!-- 1. Background Layer: ONLY this receives Opacity -->
        <Border CornerRadius="{Binding CornerRadiusValue, FallbackValue='0,0,16,16'}"
                Background="#000000"
                Opacity="{Binding Opacity, FallbackValue=0.92}"
                BorderBrush="#25FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>
        </Border>

        <!-- 2. Foreground Content Layer: 100% Solid & Fully Opaque (Clock & Badges never fade) -->
        <Grid VerticalAlignment="Center" Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status indicator dot -->
            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#10B981" Margin="0,0,8,0" />

            <!-- Live Clock Display -->
            <TextBlock x:Name="ClockText" Grid.Column="1" Text="12:00 PM"
                       FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />

            <!-- Status Badges Preview -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="🔊" FontSize="10" Foreground="#A1A1AA" Margin="2,0" />
                <TextBlock Text="⚡" FontSize="10" Foreground="#38BDF8" Margin="2,0" />
            </StackPanel>
        </Grid>
    </Grid>
</base:NonActivatingWindow>
