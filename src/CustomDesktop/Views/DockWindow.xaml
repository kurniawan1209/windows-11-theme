<base:NonActivatingWindow x:Class="CustomDesktop.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:base="clr-namespace:CustomDesktop.Views.Base"
        xmlns:vm="clr-namespace:CustomDesktop.ViewModels"
        mc:Ignorable="d"
        Title="Custom Desktop Dock"
        Width="420"
        Height="68"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Fluent Context Menu Styles -->
        <Style x:Key="FluentContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#202024" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#202024" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" Margin="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="8,4" Margin="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#383842" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A1A1AA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,3" />
        </Style>

        <!-- Dock Item Style with Uniform Width -->
        <Style x:Key="DockItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="{Binding DataContext.ItemButtonWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ItemRoot" Background="Transparent" HorizontalAlignment="Center" RenderTransformOrigin="0.5, 0.8">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1.0" ScaleY="1.0" />
                            </Grid.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.06" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="0">
        <!-- 1. Background Layer: ONLY this receives Opacity -->
        <Border CornerRadius="{Binding CornerRadius, FallbackValue=24}"
                Background="#18181B"
                Opacity="{Binding Opacity, FallbackValue=0.85}"
                BorderBrush="#35FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.4" />
            </Border.Effect>
        </Border>

        <!-- 2. Foreground Content Layer: 100% Solid & Fully Opaque (Icons never fade) -->
        <ItemsControl ItemsSource="{Binding Items}" Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DockItemButtonStyle}"
                            Click="OnDockItemClick"
                            ToolTip="{Binding Name}"
                            PreviewMouseDown="OnDockItemPreviewMouseDown">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource FluentContextMenu}">
                                <!-- Header: App Name -->
                                <MenuItem Header="{Binding Name}" IsEnabled="False" FontWeight="SemiBold" Style="{StaticResource FluentMenuItem}">
                                    <MenuItem.Icon>
                                        <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator Style="{StaticResource FluentSeparator}" />

                                <!-- Running Window Controls -->
                                <MenuItem Header="Close window" Command="{Binding CloseWindowCommand}" Style="{StaticResource FluentMenuItem}"
                                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="Close all windows" Command="{Binding CloseAllWindowsCommand}" Style="{StaticResource FluentMenuItem}"
                                          Visibility="{Binding HasMultipleWindows, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="Minimize" Command="{Binding MinimizeCommand}" Style="{StaticResource FluentMenuItem}"
                                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="Restore" Command="{Binding RestoreCommand}" Style="{StaticResource FluentMenuItem}"
                                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                                <Separator Style="{StaticResource FluentSeparator}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                                <!-- Launch Options -->
                                <MenuItem Header="New window" Command="{Binding NewInstanceCommand}" Style="{StaticResource FluentMenuItem}" />
                                <MenuItem Header="Run as administrator" Command="{Binding RunAsAdminCommand}" Style="{StaticResource FluentMenuItem}" />

                                <Separator Style="{StaticResource FluentSeparator}" />

                                <!-- Pinning Options -->
                                <MenuItem Header="{Binding PinToggleText}" Command="{Binding TogglePinCommand}" Style="{StaticResource FluentMenuItem}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Application Icon (100% Opaque) -->
                            <Image Source="{Binding Icon}"
                                   Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" />

                            <!-- Running Dot Indicators (Single dot for 1 window, Double dots for 2+ windows) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="4" Height="4" Fill="#38BDF8" Margin="0,0,1,0" />
                                <Ellipse Width="4" Height="4" Fill="#38BDF8" Margin="1,0,0,0"
                                         Visibility="{Binding HasMultipleWindows, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 3. Window Selection Picker Popup (Windows 11 Fluent style) -->
        <Popup x:Name="WindowPickerPopup"
               Placement="Top"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               VerticalOffset="-6"
               Closed="OnWindowPickerClosed">
            <Border Background="#1F1F24"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    MinWidth="220"
                    MaxWidth="360">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="PickerHeader" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="4,0,4,8" />
                    <ItemsControl x:Name="PickerItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#27272E"
                                        BorderBrush="#383842"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,3"
                                        Padding="8,6"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnPickerCardClicked">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#33333D" />
                                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="16" Height="16"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   Foreground="#F4F4F5" FontSize="12"
                                                   VerticalAlignment="Center" Margin="6,0,6,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}" />

                                        <Button Grid.Column="2" Content="✕"
                                                Foreground="#A1A1AA" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand"
                                                FontSize="11" FontWeight="Bold"
                                                Padding="0" Width="20" Height="20"
                                                Click="OnPickerCloseButtonClicked"
                                                ToolTip="Close window" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</base:NonActivatingWindow>
